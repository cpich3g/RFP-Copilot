# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=""

# Azure OpenAI configuration (required for chat agents and summarization)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Leave the key empty to use Azure Active Directory authentication via DefaultAzureCredential.
# When running locally without a key, ensure `az login` (or another supported credential) has been executed.
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-5-mini"
# Optional: only needed if you use embeddings elsewhere in the solution
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-large"
# Optional: override the default API version if required by your deployment
# Leave blank to use the service default.
AZURE_OPENAI_API_VERSION="2025-03-01-preview"

# Azure AI Search (required for compliance and vendor insights)
AZURE_AI_SEARCH_ENDPOINT=""
AZURE_AI_SEARCH_API_KEY=""

# Default index values — change if your search indexes differ
LEGAL_POLICY_INDEX="legal-policy-index"
SUPPLIER_INDEX="supplier-insights-index"

# Application defaults
GLOBAL_LLM_SERVICE="AzureOpenAI"

# Optional: Azure Speech Service for voice transcription
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

